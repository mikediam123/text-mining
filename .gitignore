# ---- DATA: never commit student responses ---------------------------------
# The raw workbook and every file derived from it stay on your machine.
/data/

# Quarto
/.quarto/
**/*.quarto_ipynb

# Knitr intermediates at the PROJECT ROOT only (see mlm-textbook for why
# the leading slash matters)
/*_files/
/*_cache/

# Rendered output and cached results contain verbatim student quotes.
# Un-ignore these two lines once you've decided where the site will live
# (see SETUP.md, "Publishing").
/docs/
/_freeze/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store
