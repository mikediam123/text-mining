# ---- DATA ------------------------------------------------------------------
# data/ holds files derived from a workbook, and a real workbook if you have one.
# NEVER commit real student responses. The synthetic workbook lives in
# sample-data/ and is safe to commit.
/data/

# Quarto
/.quarto/
**/*.quarto_ipynb

# Knitr intermediates at the PROJECT ROOT only (see mlm-textbook for why
# the leading slash matters)
/*_files/
/*_cache/

# Rendered output (docs/, _freeze/) IS committed: the book is rendered locally
# and GitHub Pages serves docs/ from main. _prerender.R refuses to render
# unless data/ was built from the synthetic workbook, so real responses can't
# end up in either folder.

# Python
__pycache__/
*.pyc

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store
