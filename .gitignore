# ---- DATA ------------------------------------------------------------------
# data/ holds files derived from a workbook, and a real workbook if you have one.
# NEVER commit real student responses. The synthetic workbook lives in
# sample-data/ and is safe to commit.
/data/

# Quarto
/.quarto/
**/*.quarto_ipynb

# Knitr intermediates at the PROJECT ROOT only (see mlm-textbook for why
# the leading slash matters)
/*_files/
/*_cache/

# Rendered output is built by GitHub Actions (.github/workflows/publish.yml) from
# the synthetic data, so it is not committed. This also guarantees that a local
# render against REAL data can never end up in the repository.
/docs/
/_freeze/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# macOS
.DS_Store
